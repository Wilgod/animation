{
  "name": "lizard-animation",
  "version": "1.0.0",
  "private": true,
  "description": "Drag-to-animate lizard path tool with deterministic MP4 export",
  "main": "main.js",
  "author": "wilso",
  "scripts": {
    "start": "node server.js",
    "prepare-assets": "node scripts/prepare-assets.js",
    "export": "electron . --export",
    "export:gif": "electron . --export --gif",
    "walk-gif": "node scripts/make-walk-gif.js",
    "electron:dev": "electron . --dev",
    "gecko": "electron . --dev --3d",
    "predist": "node scripts/copy-three-addons.cjs",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.example.pathanimator",
    "productName": "Path Animator",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "header/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "electronExport.js",
      "server.js",
      "index.html",
      "app.js",
      "engine.js",
      "style.css",
      "gecko-3d.html",
      "gecko-3d.js",
      "animal-3d.js",
      "config/**/*",
      "assets/**/*",
      "model/**/*.glb",
      "audio/**/*",
      "header/**/*",
      "node_modules/**/*",
      "scripts/lib/scenesConfig.js",
      "scripts/lib/zones.js",
      "!scripts/prepare-assets.js",
      "!scripts/make-walk-gif.js",
      "!scripts/lib/chromaKey.js",
      "!image/**",
      "!paths/**",
      "!output/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "PathAnimator-1.0.0-portable.exe"
    }
  }
}
